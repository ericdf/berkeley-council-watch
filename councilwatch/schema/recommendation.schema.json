{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Audit recommendation",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "finding_id",
  "number",
  "text",
  "addressed_to",
  "management_response",
  "citation"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9.-]*$"
  },
  "finding_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9.-]*$"
  },
  "number": {
   "type": "string",
   "minLength": 1
  },
  "text": {
   "type": "string",
   "minLength": 1
  },
  "addressed_to": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "management_response": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "position",
    "implementation_date",
    "corrective_action_plan"
   ],
   "properties": {
    "position": {
     "type": "string",
     "minLength": 1
    },
    "implementation_date": {
     "type": "string",
     "minLength": 1
    },
    "corrective_action_plan": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "citation": {
   "$ref": "citation.schema.json"
  }
 },
 "$id": "recommendation.schema.json"
}
