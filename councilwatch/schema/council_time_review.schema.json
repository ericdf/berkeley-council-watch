{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Council time: reviewed classification and inputs (data/review/council-time/)",
 "type": "object",
 "properties": {
  "threads": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "label",
     "group"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z_]+$"
     },
     "label": {
      "type": "string",
      "minLength": 1
     },
     "group": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "segments": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "segment",
     "thread",
     "auditor"
    ],
    "properties": {
     "segment": {
      "type": "string",
      "pattern": "^[a-z0-9-]+#\\d+$"
     },
     "thread": {
      "type": "string"
     },
     "auditor": {
      "type": "boolean"
     },
     "label": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "correspondence_headings": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "heading",
     "thread"
    ],
    "properties": {
     "heading": {
      "type": "string",
      "minLength": 1
     },
     "thread": {
      "type": "string"
     }
    }
   }
  },
  "transcripts": {
   "type": "object"
  },
  "turns": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "transcript",
     "thread",
     "quote",
     "within",
     "extent"
    ],
    "properties": {
     "transcript": {
      "type": "string"
     },
     "start": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
     },
     "end": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
     },
     "start_line": {
      "type": "integer",
      "minimum": 1
     },
     "end_line": {
      "type": "integer",
      "minimum": 1
     },
     "thread": {
      "type": "string"
     },
     "quote": {
      "type": "string",
      "minLength": 1
     },
     "within": {
      "type": [
       "string",
       "null"
      ]
     },
     "extent": {
      "enum": [
       "whole",
       "partial"
      ]
     }
    }
   }
  },
  "links": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "n",
     "d",
     "from",
     "to",
     "label",
     "evidence"
    ],
    "properties": {
     "n": {
      "type": "integer",
      "minimum": 1
     },
     "d": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "d2": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "from": {
      "type": "string"
     },
     "to": {
      "type": "string"
     },
     "label": {
      "type": "string",
      "minLength": 1
     },
     "evidence": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
