{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dated status",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "as_of",
  "status",
  "basis",
  "citations"
 ],
 "properties": {
  "as_of": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "status": {
   "type": "string",
   "enum": [
    "not_yet_due",
    "no_due_date_stated",
    "in_progress_reported",
    "delayed",
    "reported_complete",
    "completion_verified",
    "cancelled_or_superseded",
    "unknown_no_update_located"
   ]
  },
  "basis": {
   "type": "string",
   "minLength": 1
  },
  "citations": {
   "type": "array",
   "items": {
    "$ref": "citation.schema.json"
   }
  },
  "searched": {
   "type": "string",
   "minLength": 1
  },
  "revised_due": {
   "type": "string",
   "minLength": 1
  }
 },
 "$id": "status_entry.schema.json"
}
