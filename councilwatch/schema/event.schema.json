{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Follow-up event",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "matter_id",
  "date",
  "actor",
  "kind",
  "description",
  "citations",
  "commitment_ids",
  "recommendation_ids"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9.-]*$"
  },
  "matter_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9.-]*$"
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "actor": {
   "type": "string",
   "minLength": 1
  },
  "kind": {
   "type": "string",
   "enum": [
    "report_issued",
    "presentation",
    "council_action",
    "staff_report",
    "reported_development",
    "verification",
    "other"
   ]
  },
  "description": {
   "type": "string",
   "minLength": 1
  },
  "citations": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "citation.schema.json"
   }
  },
  "commitment_ids": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9.-]*$"
   }
  },
  "recommendation_ids": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9.-]*$"
   }
  }
 },
 "$id": "event.schema.json"
}
